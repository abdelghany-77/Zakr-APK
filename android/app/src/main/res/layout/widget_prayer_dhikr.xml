<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl">

    <!-- Subtle Islamic crescent & 8-point star watermark -->
    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_crescent_watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="12dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

        <!-- Header & Next Prayer Hero -->
        <LinearLayout
            android:id="@+id/widgetPrayerArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Slim top brand & city bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_stat_adhan"
                    android:tint="#4BE3BA" />

                <TextView
                    android:id="@+id/widgetBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/app_name"
                    android:textColor="#F2F7F5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetCityName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#8FA9A2"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/widgetRefreshBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_icon_btn_bg"
                    android:contentDescription="@string/widget_refresh_desc"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_refresh" />
            </LinearLayout>

            <!-- Hero Prayer Name + Live Countdown Capsule -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widgetNextLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_next_prayer"
                        android:textColor="#8FA9A2"
                        android:textSize="10.5sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widgetPrayerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_default_prayer"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widgetPrayerTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="--:--"
                            android:textColor="#F0C76B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Glowing Frosted Countdown Capsule -->
                <LinearLayout
                    android:id="@+id/widgetCountdownBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_bg"
                    android:gravity="center"
                    android:minWidth="84dp"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/widgetRemainingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_remaining"
                        android:textColor="#B8EFE0"
                        android:textSize="9.5sp" />

                    <Chronometer
                        android:id="@+id/widgetCountdownChrono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:textColor="#52E8C0"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widgetCountdownText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_tap_to_sync"
                        android:textColor="#52E8C0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Ornamental Gold Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_gold_divider" />

        <!-- Soft Daily Dhikr Panel -->
        <LinearLayout
            android:id="@+id/widgetDhikrArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_dhikr_bg"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/widgetDhikrLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="✦ ذِكر اليوم"
                android:textColor="#F0C76B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetDhikrText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="@string/widget_default_dhikr"
                android:textColor="#EEF5F2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Quick Navigation Shortcut Capsules -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widgetShortcutQuran"
                android:layout_width="0dp"
                android:layout_height="29dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:src="@drawable/ic_widget_quran" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/widget_shortcut_quran"
                    android:textColor="#D6F6EC"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetShortcutAzkar"
                android:layout_width="0dp"
                android:layout_height="29dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:clickable="false"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:src="@drawable/ic_widget_azkar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/widget_shortcut_azkar"
                    android:textColor="#FCE8B2"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
